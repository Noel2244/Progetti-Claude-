# Copy to .env (never commit .env). Values here are read by the engine; they are never logged.

# Optional: token required for POST endpoints, and to serve the API on a non-local interface.
SPORTS_ENGINE_API_TOKEN=

# Optional overrides
# SPORTS_ENGINE_HOME=C:\path\to\sports-engine
# SPORTS_ENGINE_DATA_DIR=D:\sports-data

# Optional paid/keyed providers are NOT required and are not implemented yet.
# If you add one, keep it optional and off by default, e.g.:
# ODDS_API_KEY=
